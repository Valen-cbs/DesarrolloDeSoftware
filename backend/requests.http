@baseUrl = http://localhost:3000
# Reemplazá el UUID por una reserva existente creada con el trabajo de Persona 2.
@reservaId = 12345678-1234-1234-1234-123456789abc

### Modificar recorrido y recalcular tarifa — 200
PATCH {{baseUrl}}/reservas/{{reservaId}}
Content-Type: application/json
X-Actor: Valentino

{ "destino": "Aeropuerto", "tipoVehiculo": "MOTO" }

### Reprogramar — 200 si ambas fechas respetan las reglas temporales
PATCH {{baseUrl}}/reservas/{{reservaId}}
Content-Type: application/json
X-Actor: Valentino

{ "fechaHora": "{{$datetime iso8601 2 d}}" }

### Historial de una reserva — 200
GET {{baseUrl}}/reservas/{{reservaId}}/historial

### Cancelar — 200 si todavía es editable
POST {{baseUrl}}/reservas/{{reservaId}}/cancelar
Content-Type: application/json
X-Actor: Valentino

{ "motivo": "Cambio de planes" }

### Historial luego de cancelar — incluye CANCELADA
GET {{baseUrl}}/reservas/{{reservaId}}/historial

### Modificar una reserva ya cancelada — 409
PATCH {{baseUrl}}/reservas/{{reservaId}}
Content-Type: application/json

{ "destino": "Terminal" }

### Campo protegido — 400
PATCH {{baseUrl}}/reservas/{{reservaId}}
Content-Type: application/json

{ "estado": "CONFIRMADA" }

### Motivo demasiado corto — 400
POST {{baseUrl}}/reservas/{{reservaId}}/cancelar
Content-Type: application/json

{ "motivo": "ab" }

### Reserva inexistente — 404
GET {{baseUrl}}/reservas/00000000-0000-0000-0000-000000000000/historial
